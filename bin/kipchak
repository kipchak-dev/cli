#!/usr/bin/env php
<?php

declare(strict_types=1);

// Installed as a dependency, the autoloader is the project's; in this repository, it is our own.
foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Kipchak\Cli\Console\Application())->run());
