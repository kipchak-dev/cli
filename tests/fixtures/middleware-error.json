    "kipchak/core": "^2 || ^3",
    "kipchak/driver-config": "^1",
    "psr/log": "^1 || ^2 || ^3"
  },
  "extra": {
    "kipchak": {
      "type": "middleware",
      "config": null,
      "configName": null,
      "initialise": "\\Kipchak\\Middleware\\Error\\Error::initialise($app);",
