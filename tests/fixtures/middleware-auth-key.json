{
  "name": "kipchak/middleware-auth-key",
  "require": {
    "kipchak/core": "^2 || ^3",
    "kipchak/driver-config": "^1",
    "kipchak/driver-logger": "^1"
  },
  "extra": {
    "kipchak": {
      "type": "middleware",
      "config": "sample.config.php",
      "configName": "kipchak.auth.key.php",
      "initialise": "\\Kipchak\\Middleware\\Auth\\Key\\Key::initialise($app);",
      "after": [
        "kipchak/middleware-feature-flags",
        "kipchak/middleware-idempotency",
        "kipchak/middleware-metering",
        "kipchak/middleware-policy",
        "kipchak/middleware-quotas",
        "kipchak/middleware-response-cache"
      ],
      "before": [
        "kipchak/middleware-audit",
        "kipchak/middleware-opentelemetry",
        "kipchak/middleware-redaction",
        "kipchak/middleware-subashi",
        "kipchak/middleware-subashi-pro"
      ],
      "docs": "https://kipchak.dev/docs/mw-auth-key"
    }
  }
}
