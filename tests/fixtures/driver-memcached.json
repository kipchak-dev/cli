{
  "name": "kipchak/driver-memcached",
  "require": {
    "symfony/cache": "^8",
    "kipchak/core": "^2 || ^3",
    "kipchak/driver-config": "^1",
    "ext-memcached": "*"
  },
  "extra": {
    "kipchak": {
      "type": "driver",
      "config": "sample.config.php",
      "configName": "kipchak.memcached.php",
      "initialise": "\\Kipchak\\Driver\\Memcached\\Memcached::initialise($container);",
      "after": [
        "kipchak/driver-config",
        "kipchak/driver-logger"
      ],
      "before": [],
      "docs": "https://kipchak.dev/docs/driver-memcached"
    }
  }
}
