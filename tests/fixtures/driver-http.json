{
  "name": "kipchak/driver-http",
  "require": {
    "guzzlehttp/guzzle": "^7.10",
    "illuminate/http": "^13.0",
    "kipchak/core": "^2 || ^3",
    "psr/http-client": "^1"
  },
  "extra": {
    "kipchak": {
      "type": "driver",
      "config": "sample.config.php",
      "configName": "kipchak.http.php",
      "initialise": "\\Kipchak\\Driver\\Http\\Http::initialise($container);",
      "after": [
        "kipchak/driver-config",
        "kipchak/driver-logger"
      ],
      "before": [],
      "docs": "https://kipchak.dev/docs/driver-http"
    }
  }
}
