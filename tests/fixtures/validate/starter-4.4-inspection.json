{
    "document": {
        "openapi": "3.0.0",
        "info": {
            "title": "Kipchak Starter API",
            "description": "An API built with Kipchak.",
            "version": "1.0.0"
        },
        "servers": [
            {
                "url": "http://localhost:8080",
                "description": "Local development"
            }
        ],
        "paths": {
            "/status": {
                "get": {
                    "tags": [
                        "Status"
                    ],
                    "summary": "Check that the API is running",
                    "operationId": "getStatus",
                    "responses": {
                        "200": {
                            "description": "The API is running.",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "allOf": [
                                            {
                                                "$ref": "#/components/schemas/Success"
                                            },
                                            {
                                                "properties": {
                                                    "code": {
                                                        "type": "integer",
                                                        "enum": [
                                                            200
                                                        ]
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "enum": [
                                                            "OK"
                                                        ]
                                                    },
                                                    "data": {
                                                        "$ref": "#/components/schemas/ApiStatus"
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "/v1/sultans": {
                "get": {
                    "tags": [
                        "Sultans"
                    ],
                    "summary": "List the sultans",
                    "operationId": "listSultans",
                    "responses": {
                        "200": {
                            "description": "Every sultan, in order of reign.",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "allOf": [
                                            {
                                                "$ref": "#/components/schemas/Success"
                                            },
                                            {
                                                "properties": {
                                                    "code": {
                                                        "type": "integer",
                                                        "enum": [
                                                            200
                                                        ]
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "enum": [
                                                            "OK"
                                                        ]
                                                    },
                                                    "data": {
                                                        "type": "array",
                                                        "items": {
                                                            "$ref": "#/components/schemas/MamlukSultan"
                                                        }
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "/v1/sultans/{id}": {
                "get": {
                    "tags": [
                        "Sultans"
                    ],
                    "summary": "Get one sultan",
                    "operationId": "getSultan",
                    "parameters": [
                        {
                            "name": "id",
                            "in": "path",
                            "required": true,
                            "schema": {
                                "type": "integer",
                                "example": 4
                            }
                        }
                    ],
                    "responses": {
                        "200": {
                            "description": "The sultan.",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "allOf": [
                                            {
                                                "$ref": "#/components/schemas/Success"
                                            },
                                            {
                                                "properties": {
                                                    "code": {
                                                        "type": "integer",
                                                        "enum": [
                                                            200
                                                        ]
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "enum": [
                                                            "OK"
                                                        ]
                                                    },
                                                    "data": {
                                                        "$ref": "#/components/schemas/MamlukSultan"
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        },
                        "404": {
                            "description": "No sultan has that ID.",
                            "content": {
                                "application/json": {
                                    "schema": {
                                        "allOf": [
                                            {
                                                "$ref": "#/components/schemas/Error"
                                            },
                                            {
                                                "properties": {
                                                    "code": {
                                                        "type": "integer",
                                                        "enum": [
                                                            404
                                                        ]
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "enum": [
                                                            "RESOURCE_NOT_FOUND"
                                                        ]
                                                    }
                                                }
                                            }
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "components": {
            "schemas": {
                "ApiStatus": {
                    "description": "Whether the API is running.",
                    "properties": {
                        "status": {
                            "description": "Always alive while the API answers.",
                            "type": "string",
                            "example": "alive"
                        }
                    },
                    "type": "object"
                },
                "MamlukSultan": {
                    "description": "A sultan of the Mamluk Sultanate.",
                    "properties": {
                        "id": {
                            "description": "Identifier of the sultan.",
                            "type": "integer",
                            "example": 4
                        },
                        "name": {
                            "description": "Name by which the sultan is known.",
                            "type": "string",
                            "example": "Baybars"
                        },
                        "reignFrom": {
                            "description": "Year the reign began (CE).",
                            "type": "integer",
                            "example": 1260
                        },
                        "reignTo": {
                            "description": "Year the reign ended (CE).",
                            "type": "integer",
                            "example": 1277
                        }
                    },
                    "type": "object"
                },
                "Success": {
                    "description": "Kipchak's response envelope, as Http\\Response::json() writes it. Each operation states what data holds.",
                    "required": [
                        "code",
                        "status",
                        "data"
                    ],
                    "properties": {
                        "code": {
                            "description": "The HTTP status.",
                            "type": "integer",
                            "example": 200
                        },
                        "status": {
                            "description": "The name of the HTTP status.",
                            "type": "string",
                            "example": "OK"
                        },
                        "meta": {
                            "description": "Endpoint metadata, such as paging, when the operation states it.",
                            "type": "object",
                            "example": {}
                        },
                        "data": {
                            "description": "The result, as each operation states it.",
                            "example": {}
                        }
                    },
                    "type": "object"
                },
                "Error": {
                    "description": "Kipchak's response envelope for an error, as kipchak/middleware-error writes it.",
                    "required": [
                        "code",
                        "status",
                        "data"
                    ],
                    "properties": {
                        "code": {
                            "description": "The HTTP status.",
                            "type": "integer",
                            "example": 404
                        },
                        "status": {
                            "description": "The type of error.",
                            "type": "string",
                            "example": "RESOURCE_NOT_FOUND",
                            "enum": [
                                "BAD_REQUEST",
                                "UNAUTHENTICATED",
                                "INSUFFICIENT_PRIVILEGES",
                                "RESOURCE_NOT_FOUND",
                                "NOT_ALLOWED",
                                "TOO_MANY_REQUESTS",
                                "NOT_IMPLEMENTED",
                                "SERVER_ERROR"
                            ]
                        },
                        "data": {
                            "description": "A message for the client.",
                            "type": "string",
                            "example": "Not found."
                        }
                    },
                    "type": "object"
                }
            },
            "responses": {
                "NotFound": {
                    "description": "The resource does not exist.",
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "code": {
                                        "description": "The top of the OpenAPI document: the API's title and version, where it is served, and the responses that\noperations share. Operations live on controllers and schemas on DTOs.",
                                        "type": "integer",
                                        "example": 404
                                    },
                                    "status": {
                                        "type": "string",
                                        "example": "RESOURCE_NOT_FOUND"
                                    },
                                    "data": {
                                        "type": "string",
                                        "example": "No sultan has the ID 99."
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                }
            }
        },
        "tags": [
            {
                "name": "Sultans",
                "description": "The sultans of the Mamluk Sultanate."
            },
            {
                "name": "Status",
                "description": "Status"
            }
        ]
    },
    "warnings": [],
    "pipeline": "project",
    "envelopeAvailable": true,
    "routes": [
        {
            "methods": [
                "GET"
            ],
            "pattern": "/v1/sultans",
            "handler": "Api\\Controllers\\v1\\Sultans::list",
            "name": null
        },
        {
            "methods": [
                "GET"
            ],
            "pattern": "/v1/sultans/{id:[0-9]+}",
            "handler": "Api\\Controllers\\v1\\Sultans::get",
            "name": null
        },
        {
            "methods": [
                "GET"
            ],
            "pattern": "/status",
            "handler": "Api\\Controllers\\Status::get",
            "name": null
        },
        {
            "methods": [
                "GET"
            ],
            "pattern": "/openapi.json",
            "handler": "Api\\Controllers\\OpenApi::get",
            "name": null
        }
    ]
}
